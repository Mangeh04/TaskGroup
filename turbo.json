{
	"$schema": "https://turborepo.com/schema.json",

	"globalEnv": ["NODE_ENV", "PUBLIC_API_URL", "API_PORT", "NEXT_PORT"],

	"ui": "tui",

	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "**/prisma/**"],
			"outputs": [
				"dist/**",
				"build/**",
				"lib/**",
				".next/**",
				"!.next/cache/**"
			]
		},

		"lint": {
			"dependsOn": ["^lint"]
		},

		"check-types": {
			"dependsOn": ["^check-types"]
		},

		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},

		"db:generate": {
			"cache": false,
			"env": ["DATABASE_URL"],
			"inputs": [
				"**/prisma/**",
				"package.json",
				"tsconfig.json",
				".env*"
			],
			"outputs": ["node_modules/.prisma/**", "**/prisma/generated/**"]
		},

		"db:deploy": {
			"cache": false,
			"env": ["DATABASE_URL"],
			"inputs": [
				"**/prisma/**",
				"package.json",
				"tsconfig.json",
				".env*"
			],
			"outputs": ["node_modules/.prisma/**", "**/prisma/generated/**"]
		}
	}
}
