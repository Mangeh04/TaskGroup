generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER // owner, can delete the project, change roles
  ADMIN // edit project, invite / kick members
  MEMBER // view, create / edit tasks
}

enum Mode {
  SYSTEM
  DARK
  LIGHT
}

enum Notification {
  INVITE
  ASSIGNMENT
}

model User {
  id       String @id @default(uuid())
  alias    String @unique
  email    String @unique
  password String

  aliasIv String
  emailIv String
  emailBi String @unique @db.VarChar(64)

  memberships ProjectMembership[]

  assignments TaskAssignment[]

  config ProfileConfiguration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  UserNotification UserNotification[]
}

model ProfileConfiguration {
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  darkMode   Mode    @default(SYSTEM)
  language   String  @default("en")
  preference Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  nameIv        String
  descriptionIv String?

  members ProjectMembership[]

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMembership {
  userId String
  user   User   @relation(fields: [userId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  role Role @default(MEMBER)

  @@id([userId, projectId])
}

model TaskAssignment {
  userId String
  user   User   @relation(fields: [userId], references: [id])

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  @@id([userId, taskId])
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  titleIv       String
  descriptionIv String?

  isCompleted Boolean @default(false)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  assignments TaskAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNotification {
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String
  projectId   String?
  type        Notification

  @@id([userId])
}
