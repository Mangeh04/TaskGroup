generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER // owner, can delete the project, change roles
  ADMIN // edit project, invite / kick members
  MEMBER // view, create / edit tasks
}

enum Theme {
  SYSTEM
  DARK
  LIGHT
}

enum Status {
  ONLINE
  OFFLINE
  AWAY
  DO_NOT_DISTURB
}

model User {
  id       String @id @default(uuid())
  alias    String @unique
  email    String @unique
  password String

  aliasIv String
  emailIv String
  emailBi String @unique @db.VarChar(64)

  memberships ProjectMembership[]
  assignments Task[]

  config ProfileConfiguration?

  taskAssignedNotifications  TaskAssignedNotification[]  @relation("TaskAssignedHolder")
  projectInviteNotifications ProjectInviteNotification[] @relation("ProjectInviteHolder")

  taskAssignedInvitesSent TaskAssignedNotification[]  @relation("TaskAssignedInviter")
  projectInvitesSent      ProjectInviteNotification[] @relation("ProjectInviteInviter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfileConfiguration {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme      Theme   @default(SYSTEM)
  language   String  @default("en")
  preference Boolean @default(true)
  status     Status  @default(ONLINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  nameIv        String
  descriptionIv String?

  members ProjectMembership[]
  assignedTasks Task[]

  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  ProjectInviteNotification ProjectInviteNotification[]
}

model ProjectMembership {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role Role @default(MEMBER)

  @@id([userId, projectId])
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  titleIv       String
  descriptionIv String?

  isCompleted Boolean @default(false)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedUserId String? 
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  TaskAssignedNotification TaskAssignedNotification[]
}

model TaskAssignedNotification {
  id String @id @default(uuid())

  holderId String
  holder   User   @relation("TaskAssignedHolder", fields: [holderId], references: [id], onDelete: Cascade)

  inviterId String
  inviter   User   @relation("TaskAssignedInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ProjectInviteNotification {
  id String @id @default(uuid())

  holderId String
  holder   User   @relation("ProjectInviteHolder", fields: [holderId], references: [id], onDelete: Cascade)

  inviterId String
  inviter   User   @relation("ProjectInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
